{
  "name": "charisna-kost",
  "version": "1.0.3",
  "private": true,
  "description": "CHARISNA KOST web, Android and Windows app",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "node --check public/cloud-sync.js && node --check public/roles.js && node scripts/check-inline.mjs",
    "build": "node scripts/build-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck",
    "build:desktop": "npm run build && electron-builder --publish never",
    "build:desktop:win": "npm run build && electron-builder --win nsis portable --publish never",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "dexie": "4.2.0",
    "dexie-react-hooks": "1.1.7",
    "firebase": "12.16.0",
    "lucide-react": "0.536.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "9.32.0",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "cross-env": "10.0.0",
    "electron": "43.8.6",
    "electron-builder": "26.18.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.0.2",
    "vitest": "4.1.12",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.charisna.kost",
    "productName": "CHARISNA KOST",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "author": {
    "name": "CHARISNA KOST"
  }
}
