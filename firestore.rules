rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && request.auth.token.email == 'charisna.homestay@gmail.com';
    }
    function cleanerFor(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'CLEANER'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    match /users/{ownerUid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == ownerUid;
    }
    match /users/{ownerUid}/cleaningTasks/{taskId} {
      allow read: if (owner() && request.auth.uid == ownerUid)
        || (cleanerFor(ownerUid) && resource.data.assigneeUid == request.auth.uid);
      allow create, delete: if owner() && request.auth.uid == ownerUid;
      allow update: if (owner() && request.auth.uid == ownerUid)
        || (cleanerFor(ownerUid)
          && resource.data.assigneeUid == request.auth.uid
          && request.resource.data.assigneeUid == resource.data.assigneeUid
          && request.resource.data.status in ['IN_PROGRESS', 'DONE']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'note', 'updatedAt']));
    }
    match /staffRequests/{staffUid} {
      allow create: if signedIn() && request.auth.uid == staffUid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ownerEmail == 'charisna.homestay@gmail.com';
      allow read: if (signedIn() && request.auth.uid == staffUid) || owner();
      allow delete: if (signedIn() && request.auth.uid == staffUid) || owner();
      allow update: if false;
    }
    match /staff/{staffUid} {
      allow read: if (signedIn() && request.auth.uid == staffUid) || owner();
      allow create: if owner() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role == 'CLEANER';
      allow update: if owner() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.role == 'CLEANER';
      allow delete: if owner() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
