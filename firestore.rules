rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && !exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function cleanerFor(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'CLEANER'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    match /users/{ownerUid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == ownerUid;
    }
    match /users/{ownerUid}/cleaningTasks/{taskId} {
      allow read: if (owner() && request.auth.uid == ownerUid)
        || (cleanerFor(ownerUid) && resource.data.assigneeUid == request.auth.uid);
      allow create, delete: if owner() && request.auth.uid == ownerUid;
      allow update: if (owner() && request.auth.uid == ownerUid)
        || (cleanerFor(ownerUid)
          && resource.data.assigneeUid == request.auth.uid
          && request.resource.data.assigneeUid == resource.data.assigneeUid
          && (request.resource.data.status in ['IN_PROGRESS', 'DONE']
            || (resource.data.status == 'TODO'
              && request.resource.data.status == 'TODO'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedItems', 'updatedAt'])))
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.get('checkedItems', []) is list
          && request.resource.data.get('checkedItems', []).size() <= 20
          && request.resource.data.get('checkedItems', []).hasOnly(resource.data.get('checklist', []))
          && (request.resource.data.status != 'DONE'
            || (request.resource.data.get('checkedItems', []).size() == resource.data.get('checklist', []).size()
              && request.resource.data.get('checkedItems', []).hasAll(resource.data.get('checklist', []))))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'note', 'updatedAt', 'checkedItems']));
    }
    match /tenantPortals/{token} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if owner() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if owner() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner() && resource.data.ownerUid == request.auth.uid;
    }
    match /tenantSubmissions/{id} {
      allow read, delete: if owner() && resource.data.ownerUid == request.auth.uid;
      allow create: if request.resource.data.keys().hasOnly(['token', 'ownerUid', 'kind', 'message', 'image', 'createdAt'])
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/tenantPortals/$(request.resource.data.token))
        && get(/databases/$(database)/documents/tenantPortals/$(request.resource.data.token)).data.expiresAt > request.time
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/tenantPortals/$(request.resource.data.token)).data.ownerUid
        && request.resource.data.kind in ['PAYMENT', 'COMPLAINT']
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.image is string && request.resource.data.image.size() <= 200000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
    match /staffRequests/{staffUid} {
      allow read, write: if false;
    }
    match /staff/{staffUid} {
      allow read: if (signedIn() && request.auth.uid == staffUid)
        || (owner() && resource.data.ownerUid == request.auth.uid);
      allow create: if owner() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role == 'CLEANER';
      allow update: if owner() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.role == 'CLEANER';
      allow delete: if owner() && resource.data.ownerUid == request.auth.uid;
    }
    match /cleaningPhotos/{photoId} {
      allow read: if (owner() && resource.data.ownerUid == request.auth.uid)
        || (cleanerFor(resource.data.ownerUid) && resource.data.uploadedBy == request.auth.uid);
      allow create: if signedIn() && cleanerFor(request.resource.data.ownerUid)
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.kind in ['BEFORE', 'AFTER', 'OTHER']
        && request.resource.data.taskId is string
        && request.resource.data.createdAt is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 350000
        && request.resource.data.keys().hasOnly(['ownerUid', 'taskId', 'uploadedBy', 'status', 'mimeType', 'kind', 'data', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/cleaningTasks/$(request.resource.data.taskId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/cleaningTasks/$(request.resource.data.taskId)).data.assigneeUid == request.auth.uid;
      allow update, delete: if owner() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
